{
  "name": "tunekit",
  "version": "1.3.1",
  "description": "Floating dev panel for tuning React UIs by eye — sliders, colors, springs and easings in a Shadow DOM panel you can drag, dock and copy back to code.",
  "license": "MIT",
  "author": "Fábio Galiano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiogaliano/tunekit.git"
  },
  "homepage": "https://github.com/fabiogaliano/tunekit#readme",
  "bugs": "https://github.com/fabiogaliano/tunekit/issues",
  "keywords": [
    "react",
    "devtools",
    "tweak",
    "tuning",
    "controls",
    "panel",
    "gui",
    "color-picker",
    "spring",
    "easing"
  ],
  "type": "module",
  "files": ["dist", "skills"],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs",
      "default": "./dist/vite.mjs"
    },
    "./palettes": {
      "types": "./dist/palettes.d.mts",
      "import": "./dist/palettes.mjs",
      "default": "./dist/palettes.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "prepare": "git config core.hooksPath .githooks || true",
    "prepack": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit",
    "check": "vp check"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "preact": "^10.25.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite-plus": "^0.1.14"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
